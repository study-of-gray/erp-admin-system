{
  "name": "erp-admin-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,css,scss}\"",
    "type-check": "vue-tsc --noEmit",
    "type-check:full": "vue-tsc --noEmit",
    "prepare": "husky",
    "test": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/strip-coverage-timestamp.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.18.1",
    "element-plus": "^2.14.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-istanbul": "^1.6.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^8.56.0",
    "husky": "^9.1.0",
    "jsdom": "^22.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "sass": "^1.101.7",
    "typescript": "5.6.2",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-element-plus": "^0.8.0",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.4.10",
    "vitest": "^1.6.1",
    "vue-tsc": "2.0.29"
  },
  "lint-staged": {
    "*.{vue,ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{vue,ts,tsx}": [
      "vue-tsc --noEmit --skipLibCheck"
    ],
    "*.{vue,ts,spec.ts}": [
      "vitest related --run --coverage"
    ]
  }
}